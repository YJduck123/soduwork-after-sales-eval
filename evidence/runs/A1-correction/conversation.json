          "content": "# -*- coding: utf-8 -*-\nimport json, re, os, sys\n\nbase = os.path.dirname(os.path.abspath(__file__))\nv1 = json.load(open(os.path.join(base, 'results.json'), encoding='utf-8'))\nv2 = json.load(open(os.path.join(base, 'results-v2.json'), encoding='utf-8'))\nsrc = json.load(open(os.path.join(base, 'development.json'), encoding='utf-8'))\n\nerrs = []\nids1 = [x['case_id'] for x in v1]\nids2 = [x['case_id'] for x in v2]\nif ids2 != [x['case_id'] for x in src]:\n    errs.append('case_id 与输入不一致')\nif len(v2) != 12 or len(set(ids2)) != 12:\n    errs.append('条数/唯一性异常')\n\nkeys = {'case_id','action','refund_cents','freight','rules','missing','reason','customer_reply'}\nACT = {'退货退款','直接退款','补发配件','补充材料','物流核查','人工复核'}\nFR = {'商家','买家','待定','不适用'}\nchanged = []\n\nfor a, b in zip(v1, v2):\n    if set(b) != keys:\n        errs.append(f\"{b['case_id']} 字段集异常\")\n    if b['action'] not in ACT or b['freight'] not in FR:\n        errs.append(f\"{b['case_id']} 枚举异常\")\n    # 核心字段必须与 v1 完全一致\n    for k in keys - {'customer_reply'}:\n        if a[k] != b[k]:\n            errs.append(f\"{b['case_id']} 核心字段被意外改动: {k}\")\n    if a['customer_reply'] != b['customer_reply']:\n        changed.append(b['case_id'])\n    # 金额/运费/动作与结构化字段一致\n    if b['action'] in {'补充材料','物流核查','人工复核'}:\n        if b['refund_cents'] is not None or b['freight'] != '待定':\n            errs.append(f\"{b['case_id']} 待定类字段不合规\")\n        if re.search(r'由(商家|您|买家)承担', b['customer_reply']):\n            errs.append(f\"{b['case_id']} 待定状态却承诺运费承担\")\n        if re.search(r'\\d+\\.\\d{2}\\s*元', b['customer_reply']):\n            errs.append(f\"{b['case_id']} 待定状态却给出金额\")\n    if b['action'] == '补发配件' and b['refund_cents'] != 0:\n        errs.append(f\"{b['case_id']} 补发金额应为 0\")\n    if b['action'] in {'退货退款','直接退款','补发配件'}:\n        if b['freight'] == '待定':\n            errs.append(f\"{b['case_id']} 确定动作下运费不应待定\")\n        if b['action'] in {'退货退款','直接退款'}:\n            yen = [float(m) for m in re.findall(r'(\\d+\\.\\d{2})\\s*元', b['customer_reply'])]\n            if yen and round(b['refund_cents']/100, 2) not in yen:\n                errs.append(f\"{b['case_id']} 回复金额与 refund_cents 不一致\")\n    # 不得声称已执行/已受理/已提交\n    for bad in ['已按','已受理','已退款','已补发','已提交','已发起','已为您','将按','已安排','我们已','已完成']:\n        if bad in b['customer_reply']:\n            errs.append(f\"{b['case_id']} 回复含既成事实表述: {bad}\")\n\nprint('改动工单:', ','.join(changed))\nprint('v2 条数:', len(v2), '| 核心字段与 v1 一致:', all(\n    all(a[k] == b[k] for k in keys - {'customer_reply'}) for a, b in zip(v1, v2)))\nif errs:\n    print('FAIL')\n    for e in errs:\n        print(' -', e)\n    sys.exit(1)\nprint('PASS: 结构、核心字段、金额/运费/动作与回复一致性、既成事实表述 全部通过')\n",
